{
  "name": "aegis-secure-chat",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end encrypted instant messaging app — text, media, 1-to-1 and group chats",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "node dist/migrate.js",
    "migrate:dev": "tsx src/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "node ./scripts/seed-env-for-test.cjs && vitest run",
    "bench": "node ./scripts/seed-env-for-bench.cjs && tsx src/bench.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --format stylish",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test",
    "prepare": "husky install",
    "vendor:sync": "node scripts/vendor-sync.cjs",
    "desktop": "electron .",
    "desktop:dist": "npm run vendor:sync && electron-builder",
    "mobile:sync": "npm run vendor:sync && cap sync",
    "mobile:android": "npm run vendor:sync && cap sync android && cap open android",
    "mobile:ios": "npm run vendor:sync && cap sync ios && cap open ios",
    "audit:runtime": "node scripts/audit.cjs",
    "audit:full": "node scripts/audit.cjs --all",
    "security:check": "npm run typecheck && npm run test && npm run audit:runtime"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aegis-secure-chat/aegis-secure-chat.git"
  },
  "bugs": {
    "url": "https://github.com/aegis-secure-chat/aegis-secure-chat/issues"
  },
  "homepage": "https://github.com/aegis-secure-chat/aegis-secure-chat#readme",
  "author": "Aegis Chat Maintainers",
  "files": [
    "dist",
    "public",
    "desktop",
    "android",
    "ios"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "arch",
    "x64"
  ],
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.29.7",
    "pg": "^8.13.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.1",
    "zlib": "^1.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pino": "^7.0.4",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "tweetnacl": "^1.0.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "chat.aegis.desktop",
    "productName": "Aegis Chat",
    "copyright": "Aegis Chat",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "public/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraMetadata": {
      "main": "desktop/main.cjs",
      "dependencies": {}
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.social-networking",
      "hardenedRuntime": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
