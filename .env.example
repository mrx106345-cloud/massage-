# Environment configuration
# Copy to .env and fill in real values before running.

# --- Server ---
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# Set SOCKET_ENABLED=false to run the HTTP API without Socket.IO.
SOCKET_ENABLED=true
# Public origin used to build verification / password-reset links.
APP_ORIGIN=http://localhost:4000
# Hops/presets to trust for req.ip behind a proxy: false | 1 | loopback | <subnet list>.
TRUST_PROXY=false

# --- Database ---
# DB_DRIVER: memory (default, ephemeral) | file (SQLite at DB_PATH) | postgres
# Use `file` for a web-client deployment: memory loses accounts and messages on
# every restart.
DB_DRIVER=file
DB_PATH=data/aegis.db
# Required when DB_DRIVER=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aegis_chat
DB_POOL_MAX=10
# Create missing tables on boot (idempotent). Set false when a migration
# pipeline owns the schema.
AUTO_MIGRATE=true

# --- Redis (login lockout counters + shared cache) ---
# Optional. Without it the API falls back to an in-process store.
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
# Must be at least 32 characters in production.
JWT_SECRET=change-me-in-production-use-a-32-char-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Lifetime of a refresh-token session row, in days.
SESSION_TTL_DAYS=30

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_SENSITIVE_MAX=5
RATE_LIMIT_CHAT_PER_MIN=120
# Failed logins per email before the account is temporarily locked out.
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15

# --- CORS ---
# Comma-separated browser origins allowed to call the API. The packaged desktop
# and mobile shells (app://aegis, capacitor://localhost, https://localhost) are
# always allowed, since a browser cannot forge those schemes.
CORS_ORIGIN=http://localhost:5173
# Extra origins, e.g. https://chat.example.com when the SPA is hosted elsewhere.
CLIENT_ORIGINS=

# --- Email (verification + password reset) ---
# Without MAIL_WEBHOOK_URL messages are written to an in-process outbox and
# logged (readable at /__dev__/outbox outside production).
EMAIL_FROM=Aegis Chat <no-reply@aegis.local>
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# --- Two-factor authentication ---
TOTP_ISSUER=Aegis Chat

# --- Media storage ---
# S3-compatible endpoint. When unset, media presigns return a local-file-safe "virtual" URL
# so the app can run without cloud credentials. Set S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY
# and S3_BUCKET to enable real signed uploads.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=aegis-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_OBJECT_URL_EXPIRES_IN=900

# --- E2EE / crypto ---
# Signal-style pre-key bundle size (number of identity + signed prekeys published).
E2EE_PREKEY_BUNDLE_COUNT=100

# --- Observability ---
# When set, /api/metrics requires `Authorization: Bearer $METRICS_TOKEN`.
METRICS_TOKEN=
DB_LOG=false

# --- Maintenance ---
MAINTENANCE_MODE=false
